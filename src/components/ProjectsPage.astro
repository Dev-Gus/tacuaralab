---
import { caseStudies, caseStudyUrl, projects } from '../lib/projects';
import type { Language } from '../lib/pages';
import { Image } from 'astro:assets';
import ProjectInvitation from './ProjectInvitation.astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const text = projects[lang];
---
<div class="max-w-3xl">
  <h1>{text.heading}</h1>
  <p class="mt-6 text-xl text-muted">{text.intro}</p>
</div>
<div class="mt-12 grid gap-6 md:grid-cols-2">
  {caseStudies.map((study) => (
    <article class="project-card flex flex-col">
      <Image src={study.content[lang].cover.src} width={800} height={450} widths={[320, 480, 800]} sizes="(min-width: 1152px) 436px, (min-width: 768px) calc((100vw - 160px) / 2), calc(100vw - 80px)" format="webp" quality={75} loading="lazy" decoding="async" alt={study.content[lang].cover.alt} class="mb-6 aspect-video h-auto w-full object-cover" />
      <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-bamboo">{study.content[lang].cardLabel}</p>
      <h2>{study.content[lang].heading}</h2>
      <p class="mt-4 text-muted">{study.content[lang].summary}</p>
      <a class="text-link mt-4" href={caseStudyUrl(lang, study)}>{text.link}</a>
    </article>
  ))}
</div>
<ProjectInvitation lang={lang} />
