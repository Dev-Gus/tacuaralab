---
import { caseStudies, caseStudyUrl, projects } from '../lib/projects';
import type { Language } from '../lib/pages';
import { Image } from 'astro:assets';
import ProjectInvitation from './ProjectInvitation.astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const text = projects[lang];
---
<div class="site-container">
<div class="page-intro">
  <h1>{text.heading}</h1>
  <p class="mt-6 text-xl text-muted">{text.intro}</p>
</div>
<div class="projects-grid mt-12 grid gap-8 md:grid-cols-2">
  {caseStudies.map((study) => (
    <article class="project-card flex flex-col">
      <Image src={study.content[lang].cover.src} width={800} height={450} widths={[320, 480, 800]} sizes="(min-width: 1152px) 528px, (min-width: 768px) calc((100vw - 96px) / 2), (min-width: 640px) calc(100vw - 64px), calc(100vw - 32px)" format="webp" quality={75} loading="lazy" decoding="async" alt={study.content[lang].cover.alt} class="mb-6 aspect-video h-auto w-full shrink-0 border border-line object-cover" />
      <p class="eyebrow">{study.content[lang].cardLabel}</p>
      <h2 class="project-title">{study.content[lang].heading}</h2>
      <p class="mt-4 text-muted">{study.content[lang].summary}</p>
      <a class="text-link mt-4" href={caseStudyUrl(lang, study)}>{text.link}</a>
    </article>
  ))}
</div>
</div>
<ProjectInvitation lang={lang} fullBleed />
