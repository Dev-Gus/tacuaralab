---
import { projects, type CaseStudy } from '../lib/projects';
import { pageUrl, type Language } from '../lib/pages';
import ProjectInvitation from './ProjectInvitation.astro';

interface Props { lang: Language; study: CaseStudy }
const { lang, study } = Astro.props;
const content = study.content[lang];
---
<div class="max-w-3xl">
  <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-bamboo">{content.label}</p>
  <h1>{content.heading}</h1>
</div>
{content.sections.map((section, index) => (
  <section class="mt-16 max-w-3xl" aria-labelledby={`case-section-${index}`}>
    <p class="eyebrow">{lang === 'es' ? 'El estudio' : 'The studio'}</p>
    <h2 id={`case-section-${index}`}>{section.heading}</h2>
    {section.text && <p class="mt-4">{section.text}</p>}
    {section.items && <ul class="mt-4 list-disc space-y-2 pl-5">
      {section.items.map((item) => <li>{item}</li>)}
    </ul>}
  </section>
))}
<ProjectInvitation lang={lang} />
<a class="text-link mt-8" href={pageUrl(lang, 'projects')}>{projects[lang].back}</a>
