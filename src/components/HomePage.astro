---
import { home } from '../lib/home';
import { pageUrl, type Language } from '../lib/pages';
import { caseStudies, caseStudyUrl } from '../lib/projects';
import { whatsappUrl } from '../lib/contact';
interface Props { lang: Language }
const { lang } = Astro.props;
const text = home[lang];
const services = pageUrl(lang, 'services');
const contact = whatsappUrl(text.message);
---
<div class="home">
  <section class="home-hero" aria-labelledby="home-title">
    <h1 id="home-title">{text.heading}</h1>
    <div class="home-hero-detail">
      <p class="text-xl text-muted">{text.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a class="button" href={contact}>{text.button}</a>
        <a class="text-link" href={services}>{text.servicesButton}</a>
      </div>
    </div>
  </section>
  <ul class="home-trust">{text.trust.map(item => <li>{item}</li>)}</ul>
  <section class="home-section" aria-labelledby="benefits-title">
    <p class="eyebrow">{lang === 'es' ? 'Servicios' : 'Services'}</p>
    <h2 id="benefits-title">{text.benefits.heading}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {text.benefits.items.map(item => <article class="open-item"><h3>{item.heading}</h3><p class="mt-4 text-muted">{item.text}</p></article>)}
    </div>
  </section>
  <section class="home-section home-layer" aria-labelledby="packages-title">
    <p class="eyebrow">{lang === 'es' ? 'Servicios' : 'Services'}</p>
    <h2 id="packages-title">{text.packages.heading}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {text.packages.items.map(item => <a class="open-item home-package" href={services}><h3>{item.heading}</h3><p class="mt-4 text-muted">{item.text}</p></a>)}
    </div>
    <a class="text-link mt-8" href={services}>{text.packages.link}</a>
  </section>
  <section class="home-section" aria-labelledby="process-title">
    <p class="eyebrow">{lang === 'es' ? 'Proceso' : 'Process'}</p>
    <h2 id="process-title">{text.process.heading}</h2>
    <ol class="home-steps mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      {text.process.items.map((item, index) => <li><span class="home-step" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3 class="mt-6">{item.heading}</h3><p class="mt-3 text-muted">{item.text}</p></li>)}
    </ol>
  </section>
  <section class="home-section home-proof" aria-labelledby="proof-title">
    <p class="eyebrow">{lang === 'es' ? 'Proyectos' : 'Projects'}</p>
    <h2 id="proof-title">{text.proof.heading}</h2>
    <div><p class="text-lg text-muted">{text.proof.text}</p><a class="text-link mt-6" href={caseStudyUrl(lang, caseStudies[0]!)}>{text.proof.button}</a></div>
  </section>
  <section class="home-closing" aria-labelledby="closing-title">
    <p class="eyebrow">{lang === 'es' ? 'Contacto' : 'Contact'}</p>
    <h2 id="closing-title">{text.closing}</h2>
    <a class="button mt-8" href={contact}>{text.button}</a>
  </section>
</div>
