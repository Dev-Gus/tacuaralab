---
import { whatsappUrl } from '../lib/contact';
import { contact } from '../lib/contactPage';
import type { Language } from '../lib/pages';

interface Props { lang: Language }
const { lang } = Astro.props;
const text = contact[lang];
---
<div class="max-w-3xl">
  <h1>{text.heading}</h1>
  <p class="mt-6 text-xl text-muted">{text.intro}</p>
  <div class="mt-8">
    <a class="button" href={whatsappUrl(text.message)} target="_blank" rel="noopener noreferrer">{text.button}</a>
    <p class="mt-3 text-sm text-muted">{text.note}</p>
  </div>
  <!-- A future form block can be inserted here, in the same content column. -->
  <div class="mt-12 grid gap-6 md:grid-cols-2">
    <section class="card" aria-labelledby="call-heading">
      <h2 id="call-heading">{text.callHeading}</h2>
      <p class="mt-4 text-xl">{text.phone}</p>
      <a class="button button-secondary mt-6" href="tel:+59898871858">{text.callButton}</a>
    </section>
    <section class="card" aria-labelledby="location-heading">
      <h2 id="location-heading">{text.locationHeading}</h2>
      <p class="mt-4">{text.location}</p>
    </section>
  </div>
  <section class="mt-12" aria-labelledby="message-heading">
    <h2 id="message-heading">{text.messageHeading}</h2>
    <ul class="mt-6 list-disc space-y-2 pl-5">
      {text.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</div>
