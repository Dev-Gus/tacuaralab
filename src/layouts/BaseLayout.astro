---
import { pageIds, pages, pageUrl, ui, type Language, type PageId } from '../lib/pages';
import { SITE_NAME } from '../data/site';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

interface Props { lang: Language; page: PageId; description: string; title?: string; localizedPaths?: Record<Language, string>; structuredData?: Record<string, unknown>[] }
const { lang, page, description, title, localizedPaths, structuredData } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';
const text = ui[lang];
const paths = localizedPaths ?? { es: pageUrl('es', page), en: pageUrl('en', page) };
const fullWidth = !localizedPaths && (page === 'home' || page === 'services' || page === 'projects' || page === 'about');
---
<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead lang={lang} title={title ?? `${pages[lang][page].title} | ${SITE_NAME}`} description={description} path={paths[lang]} localizedPaths={paths} structuredData={structuredData} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#content">{text.skip}</a>
    <header class="site-header border-b border-line">
      <div class="site-container header-inner">
        <a class="site-brand inline-flex min-h-11 items-center gap-2 whitespace-nowrap text-xl tracking-tight no-underline" href={pageUrl(lang, 'home')}>
          <svg class="shrink-0" width="18.47" height="28" viewBox="0 -2 62 94" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <g transform="rotate(12 20 45)">
              <rect x="14" y="0" width="12" height="90" rx="6" fill="#2F6048" />
              <rect x="11" y="27" width="18" height="5" rx="2.5" fill="#0B4A37" />
              <rect x="11" y="58" width="18" height="5" rx="2.5" fill="#0B4A37" />
              <path d="M26 30 C40 20 48 22 52 18 C50 30 40 36 26 30 Z" fill="#5FA777" />
            </g>
          </svg>
          Tacuara Lab
        </a>
        <nav class="site-navigation" aria-label={text.navigation}>
          <ul class="site-nav-list">
            {pageIds.map((id) => (
              <li><a class="nav-link" href={pageUrl(lang, id)} aria-current={id === page ? 'page' : undefined}>{pages[lang][id].title}</a></li>
            ))}
          </ul>
        </nav>
        <a
          class="language-link"
          href={paths[otherLang]}
          lang={otherLang}
          hreflang={otherLang}
          aria-label={text.switchLanguage}
        >{otherLang === 'es' ? 'Español' : 'English'}</a>
      </div>
    </header>
    <main id="content" tabindex="-1" class:list={['site-main flex-1', { 'site-container': !fullWidth, 'home-main': page === 'home', 'services-main': page === 'services', 'about-main': page === 'about', 'projects-main': page === 'projects' && fullWidth }]}>
      <slot />
    </main>
    <footer class="border-t border-line py-8">
      <div class="site-container flex flex-wrap items-center justify-between gap-4 text-sm">
        <p class="font-semibold">© {new Date().getUTCFullYear()} Tacuara Lab</p>
        <p class="text-muted">{text.footer}</p>
      </div>
    </footer>
  </body>
</html>
