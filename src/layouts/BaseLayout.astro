---
import { pageIds, pages, pageUrl, ui, type Language, type PageId } from '../lib/pages';
import '../styles/global.css';

interface Props { lang: Language; page: PageId; description: string; title?: string; localizedPaths?: Record<Language, string> }
const { lang, page, description, title, localizedPaths } = Astro.props;
const otherLang = lang === 'es' ? 'en' : 'es';
const text = ui[lang];
const paths = localizedPaths ?? { es: pageUrl('es', page), en: pageUrl('en', page) };
const absoluteUrl = (path: string) => new URL(path, 'https://tacuaralab.com').href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl(paths[lang])} />
    <link rel="alternate" hreflang="es" href={absoluteUrl(paths.es)} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(paths.en)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title ?? `${pages[lang][page].title} | Tacuara Lab`}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#content">{text.skip}</a>
    <header class="border-b border-line py-3 md:py-6">
      <div class="site-container flex flex-wrap items-center justify-between gap-x-4 gap-y-2 md:gap-y-4">
        <a class="inline-flex min-h-11 items-center gap-2 whitespace-nowrap text-xl font-semibold tracking-tight no-underline" href={pageUrl(lang, 'home')}>
          <svg class="shrink-0" width="18.47" height="28" viewBox="0 -2 62 94" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <g transform="rotate(12 20 45)">
              <rect x="14" y="0" width="12" height="90" rx="6" fill="#2F6048" />
              <rect x="11" y="27" width="18" height="5" rx="2.5" fill="#0B4A37" />
              <rect x="11" y="58" width="18" height="5" rx="2.5" fill="#0B4A37" />
              <path d="M26 30 C40 20 48 22 52 18 C50 30 40 36 26 30 Z" fill="#5FA777" />
            </g>
          </svg>
          Tacuara Lab
        </a>
        <a
          class="inline-flex min-h-11 items-center rounded-md border border-bamboo px-4 text-sm font-semibold text-bamboo no-underline hover:bg-bamboo hover:text-white"
          href={paths[otherLang]}
          lang={otherLang}
          hreflang={otherLang}
          aria-label={text.switchLanguage}
        >{otherLang === 'es' ? 'Español' : 'English'}</a>
        <nav class="w-full lg:w-auto" aria-label={text.navigation}>
          <ul class="site-nav-list flex gap-0 md:flex-wrap md:gap-1">
            {pageIds.map((id) => (
              <li><a class="nav-link" href={pageUrl(lang, id)} aria-current={id === page ? 'page' : undefined}>{pages[lang][id].title}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="content" tabindex="-1" class:list={['site-container flex-1 py-16 sm:py-24', { 'home-main': page === 'home' }]}>
      <slot />
    </main>
    <footer class="border-t border-line py-8">
      <div class="site-container flex flex-wrap items-center justify-between gap-4 text-sm">
        <p class="font-semibold">© {new Date().getUTCFullYear()} Tacuara Lab</p>
        <p class="text-muted">{text.footer}</p>
      </div>
    </footer>
  </body>
</html>
