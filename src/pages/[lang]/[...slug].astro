---
import { languages, pageIds, pages, ui, type Language, type PageId } from '../../lib/pages';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/AboutPage.astro';
import { about } from '../../lib/about';
import { pageUrl } from '../../lib/pages';
import { caseStudies, caseStudyUrl, projects, type CaseStudy } from '../../lib/projects';
import ProjectsPage from '../../components/ProjectsPage.astro';
import CaseStudyPage from '../../components/CaseStudyPage.astro';

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    [...pageIds.map((page) => ({
      params: { lang, slug: pages[lang][page].slug || undefined },
      props: { lang, page },
    })), ...caseStudies.map((study) => ({
      params: { lang, slug: `${pages[lang].projects.slug}/${study.content[lang].slug}` },
      props: { lang, page: 'projects' as const, study },
    }))],
  );
}

interface Props { lang: Language; page: PageId; study?: CaseStudy }
const { lang, page, study } = Astro.props;
const localizedPaths = study ? { es: caseStudyUrl('es', study), en: caseStudyUrl('en', study) } : undefined;
const isServices = page === 'services';
const title = study ? study.content[lang].title : page === 'projects' ? projects[lang].title : isServices
  ? lang === 'es'
    ? 'Servicios y precios de páginas web en Uruguay | Tacuara Lab'
    : 'Website services and pricing in Uruguay | Tacuara Lab'
  : page === 'about' ? about[lang].title : undefined;
const description = study ? study.content[lang].description : page === 'projects' ? projects[lang].description : page === 'about' ? about[lang].description : pages[lang][page].description;
const wa = (message: string) => `https://wa.me/59898871858?text=${encodeURIComponent(message)}`;
---
<BaseLayout lang={lang} page={page} description={description} title={title} localizedPaths={localizedPaths}>
  {study ? <CaseStudyPage lang={lang} study={study} /> : page === 'projects' ? <ProjectsPage lang={lang} /> : page === 'about' ? <AboutPage lang={lang} whatsappUrl={wa(about[lang].message)} /> : isServices ? (
    lang === 'es' ? (
      <>
        <div class="max-w-3xl">
          <h1 class="text-5xl">Servicios y precios</h1>
          <p class="mt-6 text-xl text-muted">Dos paquetes con precio fijo y uno a medida. Acá abajo ves qué incluye cada uno, cuánto tarda y qué no incluye.</p>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          <article class="card flex flex-col" aria-labelledby="presencia-title">
            <h2 id="presencia-title" class="text-2xl">Presencia</h2>
            <p class="mt-2 text-muted">Una página que te presenta bien y hace fácil escribirte.</p>
            <p class="mt-6 text-sm"><span class="sr-only">Precio de lista: </span><s>US$250</s></p>
            <p class="text-3xl font-semibold">US$200 <span class="text-base font-medium text-muted">precio de lanzamiento</span></p>
            <ul class="mt-6 list-disc space-y-2 pl-5">
              <li>1 página con quién sos, qué hacés, horarios y mapa</li><li>Botón de WhatsApp y de llamada con un toque</li><li>Solo en español</li><li>2 rondas de cambios</li><li>30 días de soporte después de la entrega</li><li>Entrega en 7 días hábiles</li>
            </ul>
            <a class="button mt-8 w-full lg:mt-auto" href={wa('Hola, quiero el paquete Presencia.')}>Quiero Presencia</a>
          </article>
          <article class="card flex flex-col" aria-labelledby="completo-title">
            <h2 id="completo-title" class="text-2xl">Sitio completo</h2>
            <p class="mt-2 text-muted">Para cuando una sola página no alcanza.</p>
            <p class="mt-6 text-sm"><span class="sr-only">Precio de lista: </span><s>US$450</s></p>
            <p class="text-3xl font-semibold">US$350 <span class="text-base font-medium text-muted">precio de lanzamiento</span></p>
            <p class="mt-5 font-medium">Todo lo de Presencia, más:</p>
            <ul class="mt-2 list-disc space-y-2 pl-5">
              <li>Hasta 5 páginas</li><li>Versión en español e inglés (opcional)</li><li>Formulario de contacto</li><li>Guía paso a paso para armar tu perfil de Google Business</li><li>3 rondas de cambios</li><li>60 días de soporte después de la entrega</li><li>Entrega en 15 días hábiles</li>
            </ul>
            <a class="button mt-8 w-full lg:mt-auto" href={wa('Hola, quiero el paquete Sitio completo.')}>Quiero Sitio completo</a>
          </article>
        </div>
        <section class="card mt-14" aria-labelledby="custom-title">
          <h2 id="custom-title">A medida</h2><p class="mt-4">Tienda online, reservas, usuarios con login u otra cosa que no entre en los paquetes. No tiene precio publicado: cada proyecto se cotiza según lo que necesites.</p>
          <a class="button button-secondary mt-6" href={wa('Hola, quiero cotizar un proyecto a medida.')}>Contame qué necesitás</a>
        </section>
        <section class="mt-16" aria-labelledby="launch-title"><h2 id="launch-title">Precio de lanzamiento</h2><p class="mt-4">Los primeros 5 clientes pagan el precio de lanzamiento. A cambio, me das un testimonio y me dejás mostrar tu proyecto en mi portfolio. Después, los precios pasan a los de lista.</p></section>
        <section class="mt-16" aria-labelledby="included-title"><h2 id="included-title">Qué incluyen los dos paquetes</h2><ul class="mt-4 list-disc space-y-2 pl-5"><li>Diseño a medida, pensado primero para el celular</li><li>Wordmark de texto con el nombre de tu negocio (un logo completo se cotiza aparte)</li><li>Los textos los escribo yo, a partir de una entrevista corta</li><li>Dominio .com y hosting incluidos el primer año, con el dominio a tu nombre</li><li>Reenvío de email (por ejemplo, info@tunegocio.com a tu Gmail)</li><li>Lo básico para aparecer en Google: títulos y descripciones bien armados, datos de negocio local e imagen para cuando compartan tu link</li><li>Estadísticas básicas que respetan la privacidad de tus visitantes</li></ul></section>
        <section class="mt-16" aria-labelledby="extras-title"><h2 id="extras-title">Extras</h2><ul class="mt-4 list-disc space-y-2 pl-5"><li>Página simple adicional: US$50</li><li>Mantenimiento (opcional): US$15 por mes o US$150 por año. Incluye unos 2 cambios chicos por mes, como actualizar un horario, un precio o una foto.</li></ul></section>
        <section class="mt-16" aria-labelledby="work-title"><h2 id="work-title">Cómo trabajamos</h2><ol class="mt-4 list-decimal space-y-2 pl-5"><li>Me escribís por WhatsApp y vemos qué necesitás.</li><li>Hacemos una entrevista corta para que yo escriba los textos.</li><li>Diseño y armo tu sitio.</li><li>Lo revisás y hacemos las rondas de cambios.</li><li>Lo publico y te lo entrego.</li></ol><p class="mt-6"><strong>Pago:</strong> 50% para arrancar y 50% al entregar.</p><p class="mt-2"><strong>Qué es tuyo:</strong> el dominio y el contenido son tuyos. Si querés los archivos del sitio, te los entrego.</p><p class="mt-2"><strong>Crédito:</strong> en el pie de página va un “Sitio por Tacuara Lab”, chico y discreto.</p></section>
        <section class="mt-16" aria-labelledby="excluded-title"><h2 id="excluded-title">Qué no incluyen</h2><ul class="mt-4 list-disc space-y-2 pl-5"><li>Diseño de logo</li><li>Textos largos (notas, blog, catálogos)</li><li>Fotografía profesional</li><li>Tienda online, reservas o usuarios con login (eso es A medida)</li><li>Redes sociales o publicidad paga</li><li>Casillas de correo (el reenvío sí está incluido)</li><li>Versión en inglés en Presencia (viene en Sitio completo)</li><li>Rediseños una vez aprobado el diseño</li><li>Garantía de posición en Google</li></ul></section>
        <section class="mt-16" aria-labelledby="faq-title"><h2 id="faq-title">Preguntas frecuentes</h2><div class="mt-6 space-y-6"><div><h3 class="text-lg font-semibold">¿En qué moneda pago?</h3><p class="mt-2">Los precios están en dólares. El pago se hace en pesos, al tipo de cambio del día en que pagás.</p></div><div><h3 class="text-lg font-semibold">¿Qué pasa después del primer año?</h3><p class="mt-2">El dominio y el hosting se renuevan. Te aviso con tiempo qué hay que renovar y cuánto cuesta antes de que venza.</p></div><div><h3 class="text-lg font-semibold">¿Y si quiero un .com.uy?</h3><p class="mt-2">Lo registro yo y te paso el costo real, sin recargo. Es un gasto aparte y lo confirmamos antes de arrancar.</p></div><div><h3 class="text-lg font-semibold">¿Cuánto tarda?</h3><p class="mt-2">7 días hábiles para Presencia y 15 para Sitio completo. Los plazos cuentan desde que me pasás el material que te pido (fotos, datos, respuestas de la entrevista).</p></div><div><h3 class="text-lg font-semibold">¿Me garantizás aparecer primero en Google?</h3><p class="mt-2">No, y desconfiá de quien lo haga. Dejo el sitio bien armado para que Google te entienda, pero la posición no depende solo de la página.</p></div><div><h3 class="text-lg font-semibold">¿Y si después necesito más páginas?</h3><p class="mt-2">Cada página simple extra sale US$50.</p></div></div></section>
        <section class="card mt-16" aria-labelledby="closing-title"><h2 id="closing-title">¿Dudás cuál te conviene?</h2><p class="mt-4">Escribime por WhatsApp y te digo con franqueza cuál se ajusta a tu negocio.</p><div class="mt-6 flex flex-wrap gap-4"><a class="button" href={wa('Hola, no sé cuál paquete me conviene.')}>Escribime por WhatsApp</a><a class="button button-secondary" href={pageUrl(lang, 'contact')}>Formulario de contacto</a></div></section>
      </>
    ) : (
      <>
        <div class="max-w-3xl"><h1 class="text-5xl">Services and pricing</h1><p class="mt-6 text-xl text-muted">Two fixed-price packages and one custom option. Below you can see what each includes, how long it takes, and what it doesn't cover.</p></div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          <article class="card flex flex-col" aria-labelledby="presence-title"><h2 id="presence-title" class="text-2xl">Presence</h2><p class="mt-2 text-muted">One page that presents you well and makes it easy to reach you.</p><p class="mt-6 text-sm"><span class="sr-only">List price: </span><s>US$250</s></p><p class="text-3xl font-semibold">US$200 <span class="text-base font-medium text-muted">launch price</span></p><ul class="mt-6 list-disc space-y-2 pl-5"><li>1 page with who you are, what you do, opening hours and a map</li><li>One-tap WhatsApp and call buttons</li><li>Spanish only</li><li>2 rounds of revisions</li><li>30 days of support after delivery</li><li>Delivered in 7 business days</li></ul><a class="button mt-8 w-full lg:mt-auto" href={wa('Hello, I want the Presence package.')}>I want Presence</a></article>
          <article class="card flex flex-col" aria-labelledby="full-site-title"><h2 id="full-site-title" class="text-2xl">Full site</h2><p class="mt-2 text-muted">For when one page isn't enough.</p><p class="mt-6 text-sm"><span class="sr-only">List price: </span><s>US$450</s></p><p class="text-3xl font-semibold">US$350 <span class="text-base font-medium text-muted">launch price</span></p><p class="mt-5 font-medium">Everything in Presence, plus:</p><ul class="mt-2 list-disc space-y-2 pl-5"><li>Up to 5 pages</li><li>Spanish and English versions (optional)</li><li>Contact form</li><li>Step-by-step guide to set up your Google Business Profile</li><li>3 rounds of revisions</li><li>60 days of support after delivery</li><li>Delivered in 15 business days</li></ul><a class="button mt-8 w-full lg:mt-auto" href={wa('Hello, I want the Full site package.')}>I want Full site</a></article>
        </div>
        <section class="card mt-14" aria-labelledby="custom-title"><h2 id="custom-title">Custom</h2><p class="mt-4">An online store, bookings, user logins, or anything else the packages don't cover. No published price: each project is quoted based on what you need.</p><a class="button button-secondary mt-6" href={wa('Hello, I want a quote for a custom project.')}>Tell me what you need</a></section>
        <section class="mt-16" aria-labelledby="launch-title"><h2 id="launch-title">Launch price</h2><p class="mt-4">The first 5 clients get the launch price. In exchange, you give me a testimonial and let me show your project in my portfolio. After that, prices go to the regular list price.</p></section>
        <section class="mt-16" aria-labelledby="included-title"><h2 id="included-title">Included in both packages</h2><ul class="mt-4 list-disc space-y-2 pl-5"><li>Custom design, built mobile-first</li><li>A text wordmark with your business name (a full logo is quoted separately)</li><li>I write the copy from a short interview</li><li>A .com domain and hosting included for the first year, with the domain in your name</li><li>Email forwarding (for example, info@yourbusiness.com to your Gmail)</li><li>Google basics: well-written titles and descriptions, local business data, and a preview image for when your link is shared</li><li>Basic analytics that respect your visitors' privacy</li></ul></section>
        <section class="mt-16" aria-labelledby="extras-title"><h2 id="extras-title">Extras</h2><ul class="mt-4 list-disc space-y-2 pl-5"><li>Extra simple page: US$50</li><li>Maintenance (optional): US$15 per month or US$150 per year. Covers about 2 small edits per month, like updating hours, a price or a photo.</li></ul></section>
        <section class="mt-16" aria-labelledby="work-title"><h2 id="work-title">How we work</h2><ol class="mt-4 list-decimal space-y-2 pl-5"><li>You message me on WhatsApp and we go over what you need.</li><li>We do a short interview so I can write the copy.</li><li>I design and build your site.</li><li>You review it and we do the revision rounds.</li><li>I publish it and hand it over.</li></ol><p class="mt-6"><strong>Payment:</strong> 50% to start, 50% on delivery.</p><p class="mt-2"><strong>What's yours:</strong> the domain and content are yours. If you want the site files, I'll hand them over.</p><p class="mt-2"><strong>Credit:</strong> a small, discreet “Site by Tacuara Lab” goes in the footer.</p></section>
        <section class="mt-16" aria-labelledby="excluded-title"><h2 id="excluded-title">Not included</h2><ul class="mt-4 list-disc space-y-2 pl-5"><li>Logo design</li><li>Long-form copy (articles, blog, catalogs)</li><li>Professional photography</li><li>Online store, bookings or user logins (that's Custom)</li><li>Social media or paid ads</li><li>Mailbox hosting (forwarding is included)</li><li>English version in Presence (it comes with Full site)</li><li>Redesigns after the design is approved</li><li>Google ranking guarantees</li></ul></section>
        <section class="mt-16" aria-labelledby="faq-title"><h2 id="faq-title">FAQ</h2><div class="mt-6 space-y-6"><div><h3 class="text-lg font-semibold">What currency do I pay in?</h3><p class="mt-2">Prices are in US dollars. Payment is made in Uruguayan pesos at the exchange rate on the day you pay.</p></div><div><h3 class="text-lg font-semibold">What happens after the first year?</h3><p class="mt-2">The domain and hosting renew. I'll tell you ahead of time what needs renewing and how much it costs before it expires.</p></div><div><h3 class="text-lg font-semibold">What if I want a .com.uy?</h3><p class="mt-2">I register it for you and pass on the real cost, with no markup. It's a separate expense and we confirm it before starting.</p></div><div><h3 class="text-lg font-semibold">How long does it take?</h3><p class="mt-2">7 business days for Presence and 15 for Full site. Timelines start once you've sent me the material I ask for (photos, details, interview answers).</p></div><div><h3 class="text-lg font-semibold">Can you guarantee I'll show up first on Google?</h3><p class="mt-2">No, and be wary of anyone who does. I set the site up properly so Google understands it, but ranking doesn't depend on the page alone.</p></div><div><h3 class="text-lg font-semibold">What if I need more pages later?</h3><p class="mt-2">Each extra simple page is US$50.</p></div></div></section>
        <section class="card mt-16" aria-labelledby="closing-title"><h2 id="closing-title">Not sure which one fits?</h2><p class="mt-4">Message me on WhatsApp and I'll tell you straight which one suits your business.</p><div class="mt-6 flex flex-wrap gap-4"><a class="button" href={wa("Hello, I'm not sure which package is right for me.")}>Message me on WhatsApp</a><a class="button button-secondary" href={pageUrl(lang, 'contact')}>Contact form</a></div></section>
      </>
    )
  ) : (
  <div class="max-w-3xl">
    <p class="mb-6 text-sm font-semibold uppercase tracking-widest text-bamboo">Tacuara Lab / {lang.toUpperCase()}</p>
    <h1>{pages[lang][page].title}</h1>
    <p class="mt-6 text-xl text-muted">{ui[lang].placeholder}</p>
  </div>
  <section class="card mt-12 max-w-3xl" aria-labelledby="placeholder-heading">
    <h2 id="placeholder-heading">{ui[lang].section}</h2>
    <p class="mt-4 text-muted">{ui[lang].placeholder}</p>
    <a class="button button-secondary mt-8" href={pageUrl(lang, 'home')}>{ui[lang].backHome}</a>
  </section>
  )}
</BaseLayout>
